---
import SubmissionForm from "@/components/SubmissionForm.vue";
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout title="提交" description="提交 ZZZOD 插件">
  <section class="grid gap-5 lg:grid-cols-[280px_1fr]">
    <aside>
      <h1 class="page-title">提交</h1>
      <p class="page-subtitle">GitHub Issue submission.</p>
      <div class="mt-4 flex flex-wrap gap-2 rounded border border-[var(--registry-border)] bg-[var(--registry-surface)] p-3">
        {["plugin.json", "GitHub Release", "*_const.py", "README"].map((item) => (
          <span class="rounded bg-[var(--color-fill-2)] px-2 py-1 text-xs">{item}</span>
        ))}
      </div>
    </aside>
    <SubmissionForm client:load />
  </section>
</BaseLayout>
