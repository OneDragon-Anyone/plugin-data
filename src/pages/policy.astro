---
import BaseLayout from "@/layouts/BaseLayout.astro";

const risks = ["filesystem (文件系统)", "network (网络访问)", "account (账号相关)", "automation (自动化操作)", "ocr (屏幕识别)", "yolo (图像AI)", "clipboard (剪贴板)", "process (系统进程)"];
const statuses = ["listed (已上架)", "hidden (已隐藏)", "deprecated (已弃用)", "suspended (已暂停)", "removed (已失效)"];
const submissions = ["GitHub Issue 统一模版格式审查", "GitHub 源码仓库有效性自动验证", "GitHub Release 分发压缩包完整性校验", "插件清单描述规范自动化对比"];
---

<BaseLayout title="规则" description="插件目录规则">
  <section class="max-w-4xl mx-auto">
    <div class="flex flex-col gap-1.5 mb-8">
      <h1 class="page-title">规则与定义</h1>
      <p class="text-[11px] font-bold uppercase tracking-widest text-[var(--registry-accent)]">Directory Policy & Specification</p>
    </div>

    <div class="grid gap-6 md:grid-cols-2">
      <!-- 风险标签胶囊墙 -->
      <div class="policy-card">
        <h3 class="policy-card-title">
          🛡️ 系统核心安全风险
        </h3>
        <p class="text-xs text-[var(--registry-muted)] mb-4 font-medium leading-relaxed">
          OneDragon 插件依据声明所使用的系统权限以及敏感操作划分如下核心风险标签。
        </p>
        <div class="flex flex-wrap gap-2">
          {risks.map((item) => (
            <span class="policy-pill risk-pill">{item}</span>
          ))}
        </div>
      </div>

      <!-- 状态指示 -->
      <div class="policy-card">
        <h3 class="policy-card-title">
          📌 插件分发审核状态
        </h3>
        <p class="text-xs text-[var(--registry-muted)] mb-4 font-medium leading-relaxed">
          为了确保插件的长期维护和生态纯净，插件市场中所有的模块均处于以下标准状态之一。
        </p>
        <div class="flex flex-wrap gap-2">
          {statuses.map((item) => (
            <span class="policy-pill status-pill">{item}</span>
          ))}
        </div>
      </div>

      <!-- 提交规则 -->
      <div class="policy-card md:col-span-2">
        <h3 class="policy-card-title">
          📝 插件提交与准入标准
        </h3>
        <p class="text-xs text-[var(--registry-muted)] mb-4 font-medium leading-relaxed">
          每一个提交至市场的插件，都会经过 GitHub Actions 自动化工作流与核心团队的严格交叉核对。
        </p>
        <div class="grid gap-3 sm:grid-cols-2">
          {submissions.map((item, idx) => (
            <div class="submission-rule-item">
              <span class="rule-index">0{idx + 1}</span>
              <span class="rule-text">{item}</span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .policy-card {
    border: 1px solid var(--registry-border);
    border-radius: 22px;
    background: var(--registry-surface);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    padding: 24px;
    box-shadow: var(--registry-card-shadow);
  }

  .policy-card-title {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 15px;
    font-weight: 800;
    margin: 0 0 10px 0;
    color: var(--registry-text);
  }

  .policy-pill {
    font-size: 12px;
    font-weight: 600;
    padding: 5px 12px;
    border-radius: 99px;
    border: 1px solid var(--registry-border);
    background: color-mix(in srgb, var(--registry-border) 20%, transparent);
    color: var(--registry-text);
    transition: all 0.2s ease;
  }

  .policy-pill:hover {
    transform: translateY(-1px);
  }

  .risk-pill:hover {
    border-color: color-mix(in srgb, var(--registry-accent) 40%, transparent);
    background: color-mix(in srgb, var(--registry-accent) 8%, transparent);
  }

  .status-pill:hover {
    border-color: color-mix(in srgb, var(--registry-accent-2) 40%, transparent);
    background: color-mix(in srgb, var(--registry-accent-2) 8%, transparent);
  }

  .submission-rule-item {
    display: flex;
    align-items: center;
    gap: 12px;
    background: color-mix(in srgb, var(--registry-border) 15%, transparent);
    border: 1px solid var(--registry-border);
    padding: 10px 14px;
    border-radius: 12px;
    transition: all 0.2s ease;
  }

  .submission-rule-item:hover {
    transform: translateX(2px);
    border-color: color-mix(in srgb, var(--registry-accent) 30%, transparent);
  }

  .rule-index {
    font-family: "JetBrains Mono", monospace;
    font-size: 12px;
    font-weight: 800;
    color: var(--registry-accent);
  }

  .rule-text {
    font-size: 13px;
    font-weight: 600;
    color: var(--registry-text);
  }
</style>
