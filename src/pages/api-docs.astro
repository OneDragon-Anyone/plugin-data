---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { withBase } from "@/lib/utils";

const endpoints = [
  { href: "/plugins.json", method: "GET", title: "/plugins.json", desc: "获取插件全量列表与基本配置详情数据。" },
  { href: "/search-index.json", method: "GET", title: "/search-index.json", desc: "获取轻量级 Fuse 搜索索引包以进行本地匹配。" },
  { href: "/plugins/music_game_26.json", method: "GET", title: "/plugins/{id}.json", desc: "根据插件 ID 获取单个插件的高清详细配置与文档。" }
];
---

<BaseLayout title="API" description="静态数据 API 接口文档">
  <section class="max-w-3xl mx-auto">
    <div class="flex flex-col gap-1.5 mb-8">
      <h1 class="page-title">数据接口 (API)</h1>
      <p class="text-[11px] font-bold uppercase tracking-widest text-[var(--registry-accent)]">Static Registry Data Endpoints</p>
    </div>

    <div class="grid gap-4">
      {endpoints.map((item) => (
        <div class="api-endpoint-card">
          <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
            <div class="flex-grow min-w-0">
              <div class="flex items-center gap-3 mb-2 flex-wrap">
                <span class="api-method-badge">{item.method}</span>
                <span class="mono text-sm font-bold text-[var(--registry-text)] break-all">{item.title}</span>
              </div>
              <p class="text-xs text-[var(--registry-muted)] font-medium leading-relaxed">{item.desc}</p>
            </div>
            
            <a class="api-action-btn flex items-center justify-center gap-1.5" href={withBase(item.href)} target="_blank">
              测试接口 
              <span class="arrow-indicator transition-transform inline-block">→</span>
            </a>
          </div>
        </div>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .api-endpoint-card {
    border: 1px solid var(--registry-border);
    border-radius: 20px;
    background: var(--registry-surface);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    padding: 20px;
    box-shadow: var(--registry-card-shadow);
    transition: all 0.25s cubic-bezier(0.25, 0.8, 0.25, 1);
  }

  .api-endpoint-card:hover {
    transform: translateY(-2px);
    border-color: color-mix(in srgb, var(--registry-accent) 30%, transparent);
  }

  .api-method-badge {
    font-family: "JetBrains Mono", monospace;
    font-size: 11px;
    font-weight: 800;
    padding: 2.5px 8px;
    border-radius: 6px;
    background: rgba(16, 185, 129, 0.12);
    color: #10b981;
    border: 1px solid rgba(16, 185, 129, 0.18);
  }

  /* ZZZ模式下使用绝区零黄绿色调 */
  html.zzz .api-method-badge {
    background: rgba(16, 185, 129, 0.15);
    color: var(--registry-accent-2);
    border-color: rgba(16, 185, 129, 0.25);
  }

  .api-action-btn {
    flex-shrink: 0;
    border: 1px solid var(--registry-border);
    border-radius: 12px;
    padding: 8px 16px;
    font-size: 12.5px;
    font-weight: 700;
    background: color-mix(in srgb, var(--registry-surface) 40%, transparent);
    color: var(--registry-text);
    transition: all 0.2s ease;
  }

  .api-action-btn:hover {
    background: var(--registry-surface);
    border-color: color-mix(in srgb, var(--registry-accent) 40%, transparent);
  }

  .api-action-btn:hover .arrow-indicator {
    transform: translateX(3px);
  }
</style>
